# Database
NORMA_DATABASE_URL=postgresql+psycopg://norma:norma@db:5432/norma

# Vertex AI
# NORMA_LITELLM_MODEL=vertex_ai/gemini-2.5-flash
# VERTEXAI_PROJECT=
# VERTEXAI_LOCATION=
# GOOGLE_APPLICATION_CREDENTIALS=

# Pipelines service URL
NORMA_PIPELINES_URL=http://pipelines:8001

# CORS
NORMA_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Corporate proxy (optional, used during Docker build)
# CA_CERT_PATH=/path/to/ca-cert.crt
# UV_INDEX_URL=https://pypi.org/simple/
# NPM_REGISTRY=https://registry.npmjs.org/

# Auth — generate with: openssl rand -base64 32
NORMA_JWT_SECRET_KEY=change-me-in-production

# Debug
NORMA_DEBUG=false
